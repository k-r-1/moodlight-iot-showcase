{
  "expo": {
    "name": "Moodlight",
    "slug": "openiot-moodlight",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "openiot-moodlight",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.openiot.moodlight.dev",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "새 무드등을 찾고 Wi-Fi를 설정하기 위해 Bluetooth가 필요합니다."
      }
    },
    "android": {
      "package": "com.openiot.moodlight.dev",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17131f"
      },
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "./plugins/with-esp-idf-provisioning",
      "expo-secure-store",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "새 무드등을 찾고 Wi-Fi를 설정하기 위해 Bluetooth가 필요합니다."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "16.4" },
          "android": { "minSdkVersion": 26 }
        }
      ]
    ]
  }
}
