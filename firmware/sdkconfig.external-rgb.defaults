# External common-cathode RGB hardware profile.
# Combine this with sdkconfig.defaults in a fresh build directory.
CONFIG_MOODLIGHT_LED_OUTPUT_EXTERNAL_COMMON_CATHODE=y
CONFIG_MOODLIGHT_EXTERNAL_LED_RED_GPIO=4
CONFIG_MOODLIGHT_EXTERNAL_LED_GREEN_GPIO=5
CONFIG_MOODLIGHT_EXTERNAL_LED_BLUE_GPIO=6
# CONFIG_MOODLIGHT_MQTT_RUNTIME is not set
